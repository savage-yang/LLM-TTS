            "parameters": {
                "type": "object",
                "properties": {
                    "query": {
                        "type": "string",
                        "description": "搜索关键词"
                    }
                },
                "required": ["query"]
            }
        }
    },
    {
        "type": "function",
        "function": {
            "name": "bark_push",
            "description": "用结构化内容推送通知到iOS手机（Bark通知服务），内容可包含标题、时间、地点等字段，当用户说'推送这条消息给我'、'推送通知给我'、'发通知'、'手机提醒我'时调用",
            "parameters": {
                "type": "object",
                "properties": {
                    "content": {
                        "type": "string",
                        "description": "结构化文本内容，支持标题、时间、地点、内容等字段，例如'标题:会议提醒\\n时间:14:00\\n地点:会议室A\\n内容:周会'"
                    }
                },
                "required": ["content"]
            }
        }
    }
